---
interface Props {
  src: string;
  alt: string;
  ratio?: string;
  focusY?: number;
  contrast?: number;
  lift?: number;
  credit: string;
  documentary?: {
    width: number;
    height: number;
    small: string;
    sizes: string;
    source: string;
    license?: { label: string; url: string };
    context: string;
  };
}
const { src, alt, ratio = "16 / 9", focusY = 0.5, contrast = 1.15, lift = 0.04, credit, documentary } = Astro.props;
const base = import.meta.env.BASE_URL;
const url = `${base}photos/${src}`;
---
{documentary ? (
  <figure class="photo documentary">
    <div class="frame">
      <img src={url} srcset={`${base}photos/${documentary.small} 640w, ${url} ${documentary.width}w`}
        sizes={documentary.sizes} alt={alt} width={documentary.width} height={documentary.height}
        loading="lazy" decoding="async" />
    </div>
    <figcaption>
      <span class="label">Photograph</span>
      <div>
        <a href={documentary.source}>{credit}</a>
        {documentary.license && <> · <a href={documentary.license.url}>{documentary.license.label}</a></>}
        <span class="context">{documentary.context}</span>
      </div>
    </figcaption>
  </figure>
) : (
  <figure class="photo" data-dither data-src={url} data-focus-y={focusY} data-contrast={contrast} data-lift={lift}>
    <div class="frame" style={`aspect-ratio:${ratio}`}>
      <canvas role="img" aria-label={alt}></canvas>
      <noscript><img src={url} alt={alt} style="width:100%;height:100%;object-fit:cover;filter:grayscale(1)" /></noscript>
    </div>
    <figcaption><span class="label">Photograph</span> {credit}</figcaption>
  </figure>
)}

<style>
  .documentary img {
    display: block;
    width: 100%;
    height: auto;
  }

  .documentary .frame {
    border-top: 1px solid var(--ink);
  }

  .documentary figcaption {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: .4rem 1.25rem;
    margin-top: 0;
    padding-block: .85rem 1rem;
    border-bottom: 1px solid var(--rule);
    color: var(--ink-soft);
    font-size: .85rem;
  }

  .documentary figcaption .label {
    padding-top: .15em;
    color: var(--oxblood);
  }

  .context {
    display: block;
    margin-top: .3rem;
    max-width: 65ch;
  }

  @media (max-width: 37em) {
    .documentary figcaption { grid-template-columns: 1fr; }
  }
</style>
