---
const sections = [
  { id: "overview", n: "00", title: "Introduction", sub: "The question and the four studies" },
  { id: "expectations", n: "01", title: "Expectations", sub: "NLSY97: stated chances against later births" },
  { id: "intentions", n: "02", title: "Intentions", sub: "NSFG 2022–23: what Generation Z says" },
  { id: "housing", n: "03", title: "Housing", sub: "ACS and CDC WONDER: rent burden and birth rates" },
  { id: "forecast", n: "04", title: "Forecast", sub: "HFD: fertility to 2040" },
  { id: "conclusion", n: "05", title: "Conclusion", sub: "What can and cannot be said" },
  { id: "methods", n: "06", title: "Methods", sub: "Pipeline, models, verification" },
  { id: "archive", n: "07", title: "Archive", sub: "Documents, 21 figures, sources" },
];
const base = import.meta.env.BASE_URL;
---
<a class="skip" href="#main">Skip to content</a>
<header class="masthead" data-cover>
  <div class="wrap">
    <a class="wordmark" href="#top" aria-label="The Intention Gap, back to top">
      <img src={`${base}favicon.svg`} width="18" height="18" alt="" />
      The Intention Gap
    </a>
    <nav aria-label="Chapter progress">
      <ul class="nav-links">
        {sections.map((s) => (
          <li><a href={`#${s.id}`} data-title={s.title}><span class="n">{s.n}</span>{s.title}</a></li>
        ))}
      </ul>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="index-sheet">
        <span class="current">Contents</span><span class="bars" aria-hidden="true"></span>
      </button>
    </nav>
  </div>
</header>
<nav class="index-sheet" id="index-sheet" aria-label="Chapter index" hidden>
  <ol>
    {sections.map((s) => (
      <li><a href={`#${s.id}`}><span class="n">{s.n}</span>{s.title}<small>{s.sub}</small></a></li>
    ))}
  </ol>
</nav>
