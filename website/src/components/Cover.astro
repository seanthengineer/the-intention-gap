---
import data from "../data/site-data.json";

const history = data.m11.observed.filter(([year]) => year >= 1953 && year <= 2024);
const points = history.map(([year, rate]) =>
  `${((year - 1953) * 800 / (2024 - 1953)).toFixed(2)},${(180 - rate * 40).toFixed(2)}`
).join(" ");
---
<section class="cover" aria-labelledby="cover-title">
  <div class="cover-inner wrap">
    <div class="cover-heading">
      <h1 id="cover-title">The Intention Gap</h1>
      <p>Will Generation Z have the families they say they want?</p>
    </div>
    <figure class="cover-history">
      <svg viewBox="0 0 800 180" aria-hidden="true" focusable="false">
        <path d="M0 179.5H800" class="baseline" />
        <polyline points={points} />
      </svg>
      <figcaption>
        <span>U.S. period total fertility rate, 1953–2024</span>
        <span>Human Fertility Database · CC BY 4.0</span>
      </figcaption>
    </figure>
    <a class="cover-entry" href="#overview">Scroll to the introduction</a>
  </div>
</section>

<style>
  .cover {
    background: #212221;
    color: #f1ede5;
  }

  .cover::after {
    content: "";
    display: block;
    height: clamp(2rem, 7svh, 5rem);
    background: linear-gradient(#212221, var(--paper));
  }

  .cover-inner {
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    align-content: center;
    justify-items: start;
    gap: clamp(1.65rem, 5.5svh, 4.75rem);
    padding-block: calc(var(--nav-h) + 2rem) 2rem;
  }

  h1 {
    max-width: 14ch;
    font-size: clamp(2.6rem, 1.4rem + 7.7vw, 9.5rem);
    font-weight: 390;
    line-height: 0.96;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  .cover-heading p {
    margin: clamp(1rem, 3vh, 2rem) 0 0;
    font: 400 clamp(1.15rem, 0.9rem + 1vw, 1.8rem)/1.3 var(--serif);
    max-width: 38ch;
    color: #ddd3c5;
    text-wrap: balance;
  }

  .cover-history {
    width: min(100%, 48rem);
    margin: 0;
  }

  .cover-history svg {
    width: 100%;
    overflow: visible;
  }

  .cover-history path,
  .cover-history polyline {
    fill: none;
    stroke: #c8a88b;
    stroke-width: 1.25;
    vector-effect: non-scaling-stroke;
  }

  .cover-history .baseline {
    stroke: #635f57;
    stroke-width: 1;
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
    margin-top: 0.75rem;
    color: #cfc2b3;
    font: 400 0.8125rem/1.5 var(--mono);
  }

  .cover-entry {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    gap: 0.75rem;
    font-size: 0.9375rem;
    text-decoration-color: #9b8a79;
  }

  .cover-entry::before {
    content: "";
    width: 1px;
    height: 1.75rem;
    background: linear-gradient(#d5b699, transparent);
  }

  .cover-entry:hover { text-decoration-color: currentColor; }
  .cover-entry:focus-visible { outline-color: #d5b699; }

  @media print {
    .cover { display: none; }
  }
</style>
